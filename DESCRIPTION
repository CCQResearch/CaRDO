Package: CaRDO
Type: Package
Title: CaRDO: Cancer Registry Data Online
Version: 1.0.0
Authors@R:
    c(
      person(given = "Sean", family = "Francis", role = c("aut")),
      person(given = "James", family = "Retell", email = "statistics@cancerqld.org.au", role = c("aut","cre")),    
      person(given = "James", family = "Rene", role = c("aut")),
